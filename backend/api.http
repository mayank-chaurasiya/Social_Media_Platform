@baseUrl = http://localhost:9090

### 1) Health check
GET {{baseUrl}}/
Accept: application/json

### 2) Register user
POST {{baseUrl}}/register
Content-Type: application/json

{
  "name": "Khushi",
  "email": "khushi@example.com",
  "password": "pass1234",
  "username": "khushi01"
}

### 3) Login user
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "khushi@example.com",
  "password": "pass1234"
}

### 4) Update Profile Picture
POST {{baseUrl}}/uploadProfilePicture
Content-Type: application/json

{
  "profile_picture" : "file path",
  "token": "get the token after user login"
}

### 5) Get User and their profile
GET {{baseUrl}}/get_user_and_profile
Content-Type: application/json

{
  "token": "5c67daa10e712907813ac6f3c574fa12a5925686112a1b130ba3f28d93647cb9"
}

### 6) Update profile data
POST {{baseUrl}}/update_profile_data
Content-Type: application/json

{
  "token": "d292c22fc98cefcb88e370f0f32c63760c04982ac8410cedc64de79f53a51e55",
  "bio":"",
  "currentPost": "CTO",
  "pastWork": [
    {
      "company": "Microsoft",
      "position": "CTO",
      "years": "2+"
    }
  ],
  "education": [
    {
      "school": "IIMT",
      "degree": "BCA",
      "fieldOfStudy": "2023-2026"
    }
  ]
}

### 7) Get All user profiles
GET {{baseUrl}}/user/get_all_users
Content-Type: application/json
